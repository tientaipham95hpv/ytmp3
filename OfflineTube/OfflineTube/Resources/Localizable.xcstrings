    "Artwork can be downloaded again when the device is online." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Ảnh bìa có thể được tải lại khi thiết bị có mạng." } } } },
    "Estimated size" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Dung lượng ước tính" } } } },
    "Already in Library at this format and quality" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đã có trong Thư viện với định dạng và chất lượng này" } } } },
    "Another version is in Library. You can download this variant." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Thư viện đã có phiên bản khác. Bạn vẫn có thể tải biến thể này." } } } },
    "remaining" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "còn lại" } } } },
