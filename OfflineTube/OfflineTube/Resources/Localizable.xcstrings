    "Welcome to OfflineTube" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Chào mừng đến OfflineTube" } } } },
    "Your personal offline media player for music and videos you want to keep close." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Trình phát media ngoại tuyến cá nhân cho nhạc và video bạn muốn giữ bên mình." } } } },
    "Download" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Tải xuống" } } } },
    "Paste a URL, choose an audio or video format, then download it for offline use." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Dán liên kết, chọn định dạng âm thanh hoặc video, rồi tải về để dùng ngoại tuyến." } } } },
    "Offline Player" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Trình phát ngoại tuyến" } } } },
    "Enjoy your Library without a connection, keep playing in the background, and organize media into playlists." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Thưởng thức Thư viện khi không có mạng, phát nền liên tục và sắp xếp nội dung thành playlist." } } } },
    "Storage & Privacy" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Bộ nhớ & Quyền riêng tư" } } } },
    "Your media and app data stay on this device. Review usage or remove downloads anytime in Manage Storage." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Nội dung và dữ liệu ứng dụng nằm trên thiết bị này. Xem dung lượng hoặc xóa bản tải bất cứ lúc nào trong Quản lý dung lượng." } } } },
    "Skip" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Bỏ qua" } } } },
    "Get Started" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Bắt đầu" } } } },
