    "The current download service is preserved. Change this only when using another server." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Dịch vụ tải hiện tại được giữ nguyên. Chỉ thay đổi khi dùng máy chủ khác." } } } },
